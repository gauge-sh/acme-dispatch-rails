<div class="page-head">
  <h1>Users</h1>
  <%= link_to "New user", new_user_path, class: "button" %>
</div>

<table>
  <thead>
    <tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Tokens</th></tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= link_to user.name, user %><%= " (you)" if user == current_user %></td>
        <td><%= user.email %></td>
        <td><span class="badge"><%= user.role %></span></td>
        <td>
          <% if user.is_active %>
            <span class="badge status-completed">active</span>
          <% else %>
            <span class="badge inactive">inactive</span>
          <% end %>
        </td>
        <td><%= user.api_tokens.count %></td>
      </tr>
    <% end %>
  </tbody>
</table>
