<h1>Invoice record #<%= @record.id %></h1>

<p>
  For <%= link_to @record.job.title, @record.job %>
  · <%= @record.job.customer.name %>
  · created <%= @record.created_at.to_date %>
  <% if @record.job.urgent? %>
    · <span class="badge priority-urgent">urgent +10%</span>
  <% end %>
</p>

<table>
  <thead>
    <tr><th>Line</th><th>Qty</th><th class="amount">Unit</th><th class="amount">Amount</th></tr>
  </thead>
  <tbody>
    <% @record.line_items.each do |line| %>
      <tr>
        <td>
          <%= line.description %>
          <% if line.weekend %><span class="badge">weekend +15%</span><% end %>
        </td>
        <td><%= line.quantity == line.quantity.to_i ? line.quantity.to_i : line.quantity.to_f %></td>
        <td class="amount"><%= number_to_currency(line.unit_cents / 100.0) %></td>
        <td class="amount"><%= number_to_currency(line.amount_cents / 100.0) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr><th colspan="3" class="amount">Labor</th><td class="amount"><%= number_to_currency(@record.labor_cents / 100.0) %></td></tr>
    <tr><th colspan="3" class="amount">Parts</th><td class="amount"><%= number_to_currency(@record.parts_cents / 100.0) %></td></tr>
    <tr><th colspan="3" class="amount">Total to bill</th><td class="amount"><strong><%= number_to_currency(@record.total_cents / 100.0) %></strong></td></tr>
  </tfoot>
</table>

<p class="muted">Invoice records are immutable — they are what we said we would bill at the time.</p>
