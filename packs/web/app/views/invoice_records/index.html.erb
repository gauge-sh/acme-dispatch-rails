<h1>Invoice records</h1>

<%= form_with url: invoice_records_path, method: :get, class: "filters" do %>
  <div>
    <label for="customer_id">Customer</label>
    <select name="customer_id" id="customer_id">
      <option value="">Any</option>
      <% @customers.each do |customer| %>
        <option value="<%= customer.id %>" <%= "selected" if params[:customer_id] == customer.id.to_s %>><%= customer.name %></option>
      <% end %>
    </select>
  </div>
  <button type="submit" class="subtle">Filter</button>
<% end %>

<% if @records.any? %>
  <table>
    <thead>
      <tr><th>#</th><th>Job</th><th>Customer</th><th class="amount">Labor</th><th class="amount">Parts</th><th class="amount">Total</th><th>Created</th></tr>
    </thead>
    <tbody>
      <% @records.each do |record| %>
        <tr>
          <td><%= link_to record.id, record %></td>
          <td><%= link_to record.job.title, record.job %></td>
          <td><%= record.job.customer.name %></td>
          <td class="amount"><%= cents(record.labor_cents) %></td>
          <td class="amount"><%= cents(record.parts_cents) %></td>
          <td class="amount"><strong><%= cents(record.total_cents) %></strong></td>
          <td><%= record.created_at.to_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pager", pager: @pager %>
<% elsif params[:customer_id].present? %>
  <div class="empty">Nothing billed for this customer.</div>
<% else %>
  <div class="empty">Nothing billed yet. Complete a job, then create its invoice record from the job page.</div>
<% end %>
