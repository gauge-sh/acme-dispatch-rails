<div class="page-head">
  <h1>Parts &amp; stock</h1>
  <%= link_to "New part", new_part_path, class: "button" %>
</div>

<%= form_with url: parts_path, method: :get, class: "filters" do %>
  <div>
    <label for="q">Search</label>
    <input type="search" name="q" id="q" value="<%= params[:q] %>" placeholder="SKU or name">
  </div>
  <button type="submit" class="subtle">Filter</button>
<% end %>

<% if @parts.any? %>
  <table>
    <thead>
      <tr><th>SKU</th><th>Name</th><th class="amount">Cost</th><th class="amount">Price</th><th class="amount">On hand</th></tr>
    </thead>
    <tbody>
      <% @parts.each do |part| %>
        <tr>
          <td class="mono"><%= link_to part.sku, part %></td>
          <td><%= part.name %></td>
          <td class="amount"><%= cents(part.unit_cost_cents) %></td>
          <td class="amount"><%= cents(part.unit_price_cents) %></td>
          <td class="amount"><%= part.stock_level.quantity_on_hand %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pager", pager: @pager %>
<% elsif params[:q].present? %>
  <div class="empty">No parts match “<%= params[:q] %>”.</div>
<% else %>
  <div class="empty">The catalog is empty. <%= link_to "Add a part", new_part_path %>.</div>
<% end %>
