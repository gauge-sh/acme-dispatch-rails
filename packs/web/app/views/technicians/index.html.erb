<div class="page-head">
  <h1>Technicians</h1>
  <%= link_to "New technician", new_technician_path, class: "button" %>
</div>

<%= form_with url: technicians_path, method: :get, class: "filters" do %>
  <div>
    <label for="skill">Skill</label>
    <select name="skill" id="skill">
      <option value="">Any</option>
      <% @skills.each do |skill| %>
        <option value="<%= skill %>" <%= "selected" if params[:skill] == skill %>><%= skill %></option>
      <% end %>
    </select>
  </div>
  <div>
    <label for="show">Show</label>
    <select name="show" id="show">
      <option value="">Active</option>
      <option value="inactive" <%= "selected" if params[:show] == "inactive" %>>Inactive</option>
    </select>
  </div>
  <button type="submit" class="subtle">Filter</button>
<% end %>

<% if @technicians.any? %>
  <table>
    <thead>
      <tr><th>Name</th><th>Skills</th><th>Rate</th><th>Phone</th><th></th></tr>
    </thead>
    <tbody>
      <% @technicians.each do |technician| %>
        <tr>
          <td>
            <%= link_to technician.name, technician %>
            <% unless technician.is_active %><span class="badge inactive">inactive</span><% end %>
          </td>
          <td>
            <% technician.skill_tags.each do |tag| %>
              <span class="badge"><%= tag %></span>
            <% end %>
          </td>
          <td class="amount"><%= cents(technician.hourly_cost_cents) %>/h</td>
          <td><%= technician.phone || content_tag(:span, "—", class: "muted") %></td>
          <td><%= link_to "Schedule", schedule_technician_path(technician) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pager", pager: @pager %>
<% else %>
  <div class="empty">No technicians here. <%= link_to "Add one", new_technician_path %>.</div>
<% end %>
