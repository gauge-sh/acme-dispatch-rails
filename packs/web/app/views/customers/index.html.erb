<div class="page-head">
  <h1>Customers</h1>
  <%= link_to "New customer", new_customer_path, class: "button" %>
</div>

<%= form_with url: customers_path, method: :get, class: "filters" do %>
  <div>
    <label for="q">Search</label>
    <input type="search" name="q" id="q" value="<%= @q %>" placeholder="Name or address">
  </div>
  <button type="submit" class="subtle">Filter</button>
<% end %>

<% if @customers.any? %>
  <table>
    <thead>
      <tr><th>Name</th><th>Service address</th><th>Contact</th><th>Phone</th></tr>
    </thead>
    <tbody>
      <% @customers.each do |customer| %>
        <tr>
          <td><%= link_to customer.name, customer %></td>
          <td><%= customer.service_address %></td>
          <td><%= customer.contact_email || content_tag(:span, "—", class: "muted") %></td>
          <td><%= customer.phone || content_tag(:span, "—", class: "muted") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render "shared/pager", pager: @pager %>
<% elsif @q.present? %>
  <div class="empty">No customers match “<%= @q %>”.</div>
<% else %>
  <div class="empty">No customers yet. <%= link_to "Add the first one", new_customer_path %>.</div>
<% end %>
